{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "versus-server": "esbuild server/versus-server.ts --bundle --platform=node --format=esm --outfile=.versus-server.mjs --external:ws && node .versus-server.mjs",
    "standalone": "node scripts/standalone/build.mjs",
    "build:static": "STATIC_EXPORT=1 next build",
    "breakout-sim": "esbuild scripts/breakout/sim.ts --bundle --platform=node --format=esm --outfile=.breakout-sim.mjs && node .breakout-sim.mjs",
    "breakout-browser": "node scripts/breakout/browser-check.mjs",
    "breakout-netsim": "esbuild scripts/breakout/netsim.ts --bundle --platform=node --format=esm --outfile=.breakout-netsim.mjs && node .breakout-netsim.mjs",
    "spin-rally-standalone": "node scripts/standalone/spin-rally.mjs",
    "route-selftest": "esbuild scripts/route/selftest.ts --bundle --platform=node --format=esm --outfile=.route-selftest.mjs && node .route-selftest.mjs",
    "route-browser": "node scripts/route/browser-check.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.0.4",
    "peerjs": "^1.5.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ws": "^8.21.1"
  }
}
